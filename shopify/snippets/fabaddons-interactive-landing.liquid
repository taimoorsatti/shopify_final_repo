        const v = p.variants[selectedVarIdx];
        mount.querySelector('[data-fql-price]').textContent = `$${v.price.toFixed(2)}`;
        mount.querySelector('[data-fql-compare]').textContent = `$${v.compare.toFixed(2)}`;
        mount.querySelector('[data-fql-save]').textContent = `Save ${calcSave(v)}%`;
        mount.querySelector('[data-fql-total]').textContent = `$${v.price.toFixed(2)}`;
      };
      updatePricing();

      const mainImg = mount.querySelector('[data-fql-main-img]');
      const thumbBtns = Array.from(mount.querySelectorAll('[data-fql-thumb]'));
      const setSlide = (next) => {
        slideIdx = (next + p.images.length) % p.images.length;
        mainImg.src = p.images[slideIdx];
        thumbBtns.forEach((b, i) => b.classList.toggle('is-active', i === slideIdx));
      };
      thumbBtns.forEach((b, i) => b.addEventListener('click', () => setSlide(i)));
      mount.querySelector('[data-fql-gprev]').addEventListener('click', () => setSlide(slideIdx - 1));
      mount.querySelector('[data-fql-gnext]').addEventListener('click', () => setSlide(slideIdx + 1));

      const packBtns = Array.from(mount.querySelectorAll('[data-fql-pack]'));
      packBtns.forEach((b, i) => {
        b.addEventListener('click', () => {
          selectedVarIdx = i;
          packBtns.forEach((el, j) => el.classList.toggle('is-selected', j === i));
          updatePricing();
        });
      });

      mount.querySelector('[data-fql-add]').addEventListener('click', () => {
        addToShopifyOrBag(p, p.variants[selectedVarIdx]);
      });

      const stepBtns = Array.from(mount.querySelectorAll('[data-fql-step]'));
      const wcap = mount.querySelector('[data-fql-wcap]');
      stepBtns.forEach((b, i) => {
        b.addEventListener('click', () => {
          stepBtns.forEach((el, j) => el.classList.toggle('is-active', j === i));
          wcap.textContent = `0${i + 1} · ${p.walkSteps[i]}`;
        });
      });

      const rplay = mount.querySelector('[data-fql-rplay]');
      const reelEl = mount.querySelector('[data-fql-reel]');
      rplay.addEventListener('click', () => {
        reelPaused = !reelPaused;
        reelEl.src = reelPaused ? p.poster : p.reel;
        rplay.textContent = reelPaused ? 'Play' : 'Pause';
      });

      const baRange = mount.querySelector('[data-fql-ba-range]');
      const baOver = mount.querySelector('[data-fql-ba-over]');
      const baDiv = mount.querySelector('[data-fql-ba-div]');
      baRange.addEventListener('input', () => {
        const val = Number(baRange.value) || 50;
        baOver.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
        baDiv.style.left = `${val}%`;
      });

      mount.querySelectorAll('[data-fql-home]').forEach((b) => {
        b.addEventListener('click', () => closeProductLanding(b.getAttribute('data-fql-home') || ''));
      });
      mount.querySelector('[data-fql-buybox]').addEventListener('click', () => {
        mount.querySelector('#fql-buy-box')?.scrollIntoView({ behavior: 'smooth' });
      });

      Array.from(mainContent.children).forEach((child) => {
        if (child !== mount) child.hidden = true;
      });
      mount.hidden = false;
      history.replaceState(null, '', '#fab-product=' + p.key);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    document.addEventListener('click', (e) => {
      const prodTrigger = e.target.closest('[data-fab-product]');
      if (prodTrigger) {
        e.preventDefault();
        openProductLanding(prodTrigger.getAttribute('data-fab-product'));
        return;
      }
      const bagTrigger = e.target.closest('[data-fab-open-bag]');
      if (bagTrigger) {
        e.preventDefault();
        openBag();
        return;
      }
      const homeTrigger = e.target.closest('[data-fab-home-link]');
      if (homeTrigger && !mount.hidden && isHomePath()) {
        e.preventDefault();
        const anchor = homeTrigger.getAttribute('data-fab-anchor') || '';
        closeProductLanding(anchor);
      }
    });

    window.addEventListener('hashchange', () => {
      if (location.hash.startsWith('#fab-product=')) {
        openProductLanding(location.hash.replace('#fab-product=', ''));
      } else if (!mount.hidden) {
        closeProductLanding(location.hash || '');
      }
    });

    saveBag();
    if (location.hash.startsWith('#fab-product=')) {
      openProductLanding(location.hash.replace('#fab-product=', ''));
    }
  })();
</script>
