        const res = await fetch(`${rootUrl}products/${product.handle}.js`);
        if (res.ok) {
          const shopProd = await res.json();
          const firstVar = shopProd.variants && shopProd.variants[0];
          if (firstVar) {
            await fetch(`${rootUrl}cart/add.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: firstVar.id, quantity: variant.qty })
            });
          }
        }
      } catch (_e) {}
    };

