{% comment %}
  fabaddons — Built-in Interactive One-Page Product Landing & Bag Drawer
  Ensures clicking any product card opens the full Add-to-Cart Product Landing Page immediately,
  matching the storefront preview even before products are manually linked in Theme Editor.
{% endcomment %}

<div id="FabQuickLanding" class="fql-root" hidden aria-live="polite"></div>

<div id="FabBagOverlay" class="fbg-overlay" hidden>
  <aside class="fbg-drawer" role="dialog" aria-modal="true" aria-label="Shopping Bag">
    <div class="fbg-head">
      <div>
        <h2 class="fbg-title">Your Bag</h2>
        <p class="fbg-sub" data-fbg-sub>0 items in your bag</p>
      </div>
      <button type="button" class="fbg-close" data-fbg-close aria-label="Close shopping bag">&times;</button>
    </div>
    <div class="fbg-body" data-fbg-body></div>
    <div class="fbg-foot" data-fbg-foot hidden>
      <div class="fbg-total-row">
        <span>Subtotal</span>
        <strong data-fbg-subtotal>$0.00</strong>
      </div>
      <a href="{{ routes.cart_url }}" class="fbg-checkout-btn">Go to Cart &amp; Checkout &rarr;</a>
      <button type="button" class="fbg-continue-btn" data-fbg-close>Continue Shopping</button>
    </div>
  </aside>
</div>

