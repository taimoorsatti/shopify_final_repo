    const mount = document.getElementById('FabQuickLanding');
    const mainContent = document.getElementById('MainContent');
    const bagOverlay = document.getElementById('FabBagOverlay');
    const bagBody = document.querySelector('[data-fbg-body]');
    const bagSub = document.querySelector('[data-fbg-sub]');
    const bagFoot = document.querySelector('[data-fbg-foot]');
    const bagSubtotal = document.querySelector('[data-fbg-subtotal]');
    if (!mount || !mainContent) return;

    const STORAGE_KEY = 'fabaddons_bag_v1';
    let bagItems = [];
    try {
      bagItems = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch (_e) {
      bagItems = [];
    }

    const saveBag = () => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(bagItems)); } catch (_e) {}
      const totalCount = bagItems.reduce((s, it) => s + it.qty, 0);
      document.querySelectorAll('[data-cart-count]').forEach((el) => {
        el.textContent = String(totalCount);
      });
    };

    const renderBag = () => {
      if (!bagBody || !bagSub || !bagFoot || !bagSubtotal) return;
      const totalCount = bagItems.reduce((s, it) => s + it.qty, 0);
      const subtotal = bagItems.reduce((s, it) => s + it.price * it.qty, 0);
      bagSub.textContent = `${totalCount} ${totalCount === 1 ? 'item' : 'items'} in your bag`;
      bagBody.innerHTML = '';
      if (!bagItems.length) {
        const empty = document.createElement('div');
        empty.className = 'fbg-empty';
        empty.textContent = 'Your bag is currently empty. Choose any product to add items.';
        bagBody.appendChild(empty);
        bagFoot.hidden = true;
        return;
      }
      bagFoot.hidden = false;
      bagSubtotal.textContent = `$${subtotal.toFixed(2)}`;
      bagItems.forEach((it, idx) => {
        const row = document.createElement('div');
        row.className = 'fbg-item';
        const img = document.createElement('img');
        img.src = it.image;
        img.width = 72;
        img.height = 72;
        img.alt = it.title;
        img.className = 'fbg-item-img';
        const info = document.createElement('div');
        const h = document.createElement('p');
        h.className = 'fbg-item-title';
        h.textContent = it.title;
        const m = document.createElement('p');
        m.className = 'fbg-item-meta';
        m.textContent = `${it.label} — $${it.price.toFixed(2)}`;
        const bar = document.createElement('div');
        bar.className = 'fbg-qty-bar';
        const ctrl = document.createElement('div');
        ctrl.className = 'fbg-qty-ctrl';
        const dec = document.createElement('button');
        dec.type = 'button';
        dec.textContent = '−';
        dec.addEventListener('click', () => {
          bagItems[idx].qty -= 1;
          if (bagItems[idx].qty <= 0) bagItems.splice(idx, 1);
          saveBag();
          renderBag();
        });
        const qtySpan = document.createElement('span');
        qtySpan.textContent = String(it.qty);
        const inc = document.createElement('button');
        inc.type = 'button';
        inc.textContent = '+';
        inc.addEventListener('click', () => {
          bagItems[idx].qty += 1;
          saveBag();
          renderBag();
        });
        ctrl.append(dec, qtySpan, inc);
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'fbg-rm';
        rm.textContent = 'Remove';
        rm.addEventListener('click', () => {
          bagItems.splice(idx, 1);
          saveBag();
          renderBag();
        });
        bar.append(ctrl, rm);
        info.append(h, m, bar);
        row.append(img, info);
        bagBody.appendChild(row);
      });
    };

    const openBag = () => {
      renderBag();
      if (bagOverlay) bagOverlay.hidden = false;
    };
    const closeBag = () => {
      if (bagOverlay) bagOverlay.hidden = true;
    };

    document.querySelectorAll('[data-fbg-close]').forEach((el) => el.addEventListener('click', closeBag));
