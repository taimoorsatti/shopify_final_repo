{% comment %}
  fabaddons — See It In Action (9:16 Video Carousel)
  Upload to: sections/fabaddons-see-it-in-action.liquid
  Supports Shopify Files video picker, external MP4 URL, and bundled animated WebP reels.
{% endcomment %}

<section id="see-it-in-action" class="fab-video-section">
  <div class="fab-video-container">
    <h2 class="fab-video-heading">{{ section.settings.heading | escape }}</h2>
    <p class="fab-video-sub">{{ section.settings.subtitle | escape }}</p>

    <div class="fab-video-carousel" data-fab-vcarousel="{{ section.id }}">
      <button type="button" class="fab-circle-arrow" aria-label="Previous video" data-vprev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="fab-video-viewport">
        <div class="fab-video-track" data-vtrack>
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% assign mp4_url = block.settings.mp4_url %}

            {% assign poster_url = '' %}
            {% if block.settings.poster != blank %}
              {% assign poster_url = block.settings.poster | image_url: width: 720 %}
            {% elsif product != blank and product.featured_image != blank %}
              {% assign poster_url = product.featured_image | image_url: width: 720 %}
            {% elsif block.settings.fallback_poster_asset != blank %}
              {% assign poster_url = block.settings.fallback_poster_asset | asset_url %}
            {% endif %}

            {% assign reel_url = '' %}
            {% if block.settings.fallback_reel_asset != blank %}
              {% assign reel_url = block.settings.fallback_reel_asset | asset_url %}
            {% endif %}

            <div class="fab-video-card" {{ block.shopify_attributes }}>
              <div class="fab-video-frame">
                {% if poster_url != blank %}
                  <img src="{{ poster_url }}" width="720" height="1280" alt="{{ block.settings.custom_label | default: product.title | escape }}" class="fab-video-el fab-video-poster-bg" loading="lazy">
                {% endif %}

                {% if block.settings.shopify_video != blank %}
                  {{ block.settings.shopify_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'fab-video-el fab-video-layer' }}
                {% elsif mp4_url != blank %}
                  <video class="fab-video-el fab-video-layer" {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %} autoplay loop muted playsinline preload="metadata">
                    <source src="{{ mp4_url }}" type="video/mp4">
                  </video>
                {% elsif reel_url != blank %}
                  <img
                    src="{{ reel_url }}"
                    data-reel-src="{{ reel_url }}"
                    data-poster-src="{{ poster_url }}"
                    width="360"
                    height="640"
                    alt="{{ block.settings.custom_label | default: product.title | escape }}"
                    class="fab-video-el fab-video-layer"
                    loading="lazy"
                  >
                {% endif %}

                <div class="fab-video-controls">
                  <button type="button" class="fab-ctrl-pill" data-vplay aria-label="Play or pause">Pause</button>
                  {% if block.settings.shopify_video != blank or mp4_url != blank %}
                    <button type="button" class="fab-ctrl-pill" data-vmute aria-label="Toggle sound">Unmute</button>
                  {% endif %}
                </div>
              </div>

              <div class="fab-video-footer">
                <div class="fab-video-meta">
                  <span class="fab-video-label">{{ block.settings.custom_label | default: product.title | escape }}</span>
                  <span class="fab-video-price">
                    {% if product != blank %}
                      {{ product.price | money }}
                    {% else %}
                      {{ block.settings.fallback_price | escape }}
                    {% endif %}
                  </span>
                </div>
                {% if product != blank %}
                  <a href="{{ product.url }}" class="fab-shop-btn">Shop</a>
                {% else %}
                  {% assign fab_vkey = 'eye-cream' %}
                  {% assign vlabel_lc = block.settings.custom_label | downcase %}
                  {% if vlabel_lc contains 'turmeric' %}
                    {% assign fab_vkey = 'turmeric-pads' %}
                  {% elsif vlabel_lc contains 'peel' or vlabel_lc contains 'kojic' %}
                    {% assign fab_vkey = 'peel-spray' %}
                  {% elsif vlabel_lc contains 'snore' or vlabel_lc contains 'mouth' %}
                    {% assign fab_vkey = 'anti-snore' %}
                  {% endif %}
                  <a href="{{ routes.root_url }}#fab-product={{ fab_vkey }}" data-fab-product="{{ fab_vkey }}" class="fab-shop-btn">Shop</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <button type="button" class="fab-circle-arrow" aria-label="Next video" data-vnext>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <div class="fab-vdots" data-vdots="{{ section.id }}"></div>
  </div>
</section>

<style>
  .fab-video-section { padding: 64px 20px; background: #ffffff; border-top: 1px solid #f1f5f9; }
  .fab-video-container { max-width: 1040px; margin: 0 auto; }
  .fab-video-heading { text-align: center; font-size: clamp(26px, 3vw, 34px); font-weight: 700; color: #111827; margin: 0; }
  .fab-video-sub { text-align: center; color: #64748b; font-size: 15px; margin: 8px 0 36px; }
  .fab-video-carousel { display: flex; align-items: center; gap: 14px; }
  .fab-video-viewport { overflow: hidden; width: 100%; touch-action: pan-y; }
  .fab-video-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 40px) / 3); gap: 20px; transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .fab-video-card { border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden; background: #ffffff; }
  .fab-video-frame { position: relative; aspect-ratio: 9 / 16; background: #111827; overflow: hidden; }
  .fab-video-el { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fab-video-poster-bg { position: absolute; inset: 0; z-index: 1; }
  .fab-video-layer { position: relative; z-index: 2; }
  .fab-video-controls { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; justify-content: space-between; z-index: 4; }
  .fab-ctrl-pill { background: rgba(17,24,39,0.72); color: #ffffff; border: 0; border-radius: 9999px; padding: 6px 12px; font-size: 11px; font-weight: 600; cursor: pointer; }
  .fab-video-footer { padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .fab-video-meta { min-width: 0; }
  .fab-video-label { display: block; font-size: 13px; font-weight: 600; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fab-video-price { display: block; font-size: 12px; color: #64748b; margin-top: 2px; }
  .fab-shop-btn { background: #111827; color: #ffffff; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; flex-shrink: 0; }
  .fab-video-carousel .fab-circle-arrow { width: 40px; height: 40px; border-radius: 9999px; border: 1px solid #e3e8ed; background: #ffffff; color: #17212c; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .fab-vdots { display: flex; justify-content: center; gap: 8px; margin-top: 22px; }
  .fab-vdot { width: 8px; height: 8px; border-radius: 9999px; border: 0; background: #cbd5e1; cursor: pointer; padding: 0; }
  .fab-vdot.is-active { width: 22px; background: #111827; }
  @media (max-width: 767px) { .fab-video-track { grid-auto-columns: 100%; gap: 16px; } }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-fab-vcarousel="{{ section.id }}"]');
    const dotsWrap = document.querySelector('[data-vdots="{{ section.id }}"]');
    if (!root) return;
    const track = root.querySelector('[data-vtrack]');
    const viewport = root.querySelector('.fab-video-viewport');
    let index = 0;
    let touchStartX = 0;
    const visible = () => (window.innerWidth < 768 ? 1 : 3);
    const update = () => {
      const maxIndex = Math.max(0, track.children.length - visible());
      index = Math.max(0, Math.min(index, maxIndex));
      const card = track.children[0];
      if (card) {
        const gap = parseFloat(getComputedStyle(track).gap) || 20;
        track.style.transform = `translateX(-${index * (card.getBoundingClientRect().width + gap)}px)`;
      }
      if (dotsWrap) {
        dotsWrap.innerHTML = '';
        for (let i = 0; i <= maxIndex; i++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'fab-vdot' + (i === index ? ' is-active' : '');
          b.addEventListener('click', () => { index = i; update(); });
          dotsWrap.appendChild(b);
        }
      }
    };
    root.querySelector('[data-vprev]')?.addEventListener('click', () => { index--; update(); });
    root.querySelector('[data-vnext]')?.addEventListener('click', () => { index++; update(); });
    viewport?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });
    viewport?.addEventListener('touchend', (e) => {
      const delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 40) {
        index += delta < 0 ? 1 : -1;
        update();
      }
    }, { passive: true });
    root.querySelectorAll('.fab-video-card').forEach((card) => {
      const video = card.querySelector('video');
      const reelImg = card.querySelector('img[data-reel-src]');
      const playBtn = card.querySelector('[data-vplay]');
      const muteBtn = card.querySelector('[data-vmute]');
      let reelPaused = false;
      if (video) {
        video.addEventListener('error', () => {
          video.style.display = 'none';
        });
      }
      playBtn?.addEventListener('click', () => {
        if (video) {
          if (video.paused) { video.play(); playBtn.textContent = 'Pause'; }
          else { video.pause(); playBtn.textContent = 'Play'; }
          return;
        }
        if (reelImg) {
          reelPaused = !reelPaused;
          const nextSrc = reelPaused ? reelImg.dataset.posterSrc : reelImg.dataset.reelSrc;
          if (nextSrc) reelImg.src = nextSrc;
          playBtn.textContent = reelPaused ? 'Play' : 'Pause';
        }
      });
      muteBtn?.addEventListener('click', () => {
        if (!video) return;
        video.muted = !video.muted;
        muteBtn.textContent = video.muted ? 'Unmute' : 'Mute';
      });
    });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "fabaddons Video Reels",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It In Action" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Discover your daily favorites." }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "video", "id": "shopify_video", "label": "Shopify hosted video" },
        { "type": "url", "id": "mp4_url", "label": "MP4 URL (optional)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "text", "id": "custom_label", "label": "Product label", "default": "Dr. Melaxin Eyephalt Eye Cream" },
        { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "$34.00" },
        { "type": "text", "id": "fallback_reel_asset", "label": "Bundled reel asset", "default": "demo_eye_cream.webp" },
        { "type": "text", "id": "fallback_poster_asset", "label": "Bundled poster asset", "default": "video_eye_cream.jpg" }
      ]
    }
  ],
  "presets": [{ "name": "fabaddons Video Reels" }]
}
{% endschema %}