{% comment %}
  fabaddons — Scrolling Benefits Marquee
  Upload to: sections/fabaddons-benefits-marquee.liquid
{% endcomment %}

<div id="FabBenefits-{{ section.id }}" class="fab-benefits-marquee" role="region" aria-label="Shopping benefits">
  <div class="fab-benefits-track">
    {% for pass in (1..4) %}
      {% for block in section.blocks %}
        <div class="fab-benefit-item" {{ block.shopify_attributes }}>
          <span>{{ block.settings.label | escape }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C13.6 7.4 16.6 10.4 24 12C16.6 13.6 13.6 16.6 12 24C10.4 16.6 7.4 13.6 0 12C7.4 10.4 10.4 7.4 12 0Z"/>
          </svg>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<style>
  #FabBenefits-{{ section.id }} { background: #f4f7fa; border-bottom: 1px solid #e3e8ed; overflow: hidden; padding: 14px 0; }
  #FabBenefits-{{ section.id }} .fab-benefits-track { display: flex; width: max-content; animation: fabMarquee 34s linear infinite; }
  #FabBenefits-{{ section.id }} .fab-benefit-item { display: inline-flex; align-items: center; gap: 24px; padding: 0 12px; font-size: 13px; font-weight: 500; color: #17212c; white-space: nowrap; }
  #FabBenefits-{{ section.id }} .fab-benefit-item svg { color: #145592; flex-shrink: 0; }
  @keyframes fabMarquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "fabaddons Benefits Strip",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "label", "label": "Benefit text", "default": "3-Day Express Delivery" }
      ]
    }
  ],
  "presets": [
    {
      "name": "fabaddons Benefits Strip",
      "blocks": [
        { "type": "benefit", "settings": { "label": "3-Day Express Delivery" } },
        { "type": "benefit", "settings": { "label": "Secure Checkout" } },
        { "type": "benefit", "settings": { "label": "24/7 Customer Support" } },
        { "type": "benefit", "settings": { "label": "Curated Daily Essentials" } }
      ]
    }
  ]
}
{% endschema %}