{% comment %}
  fabaddons — Shopping Bag (Cart)
  Upload to: sections/fabaddons-cart.liquid
{% endcomment %}

<section class="fab-cart-section">
  <div class="fab-cart-wrap">
    <h1 class="fab-cart-heading">Your Shopping Bag</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="fab-cart-form">
        <div class="fab-cart-items">
          {% for item in cart.items %}
            <div class="fab-cart-row">
              {% if item.image != blank %}
                {{ item.image | image_url: width: 240 | image_tag: class: 'fab-cart-thumb', alt: item.title }}
              {% else %}
                <img src="{{ 'product_eye_cream.jpg' | asset_url }}" alt="{{ item.title | escape }}" class="fab-cart-thumb">
              {% endif %}
              <div class="fab-cart-info">
                <a href="{{ item.url }}" class="fab-cart-title">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="fab-cart-var">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="fab-cart-price">{{ item.final_line_price | money }}</p>
              </div>
              <div class="fab-cart-actions">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="fab-cart-qty">
                <a href="{{ item.url_to_remove }}" class="fab-cart-remove">Remove</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="fab-cart-summary">
          <div class="fab-cart-total">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="fab-cart-btns">
            <button type="submit" name="update" class="fab-cart-update">Update Bag</button>
            <button type="submit" name="checkout" class="fab-cart-checkout">Checkout &rarr;</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="fab-cart-empty">
        <p>Your bag is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="fab-cart-checkout">Continue Shopping &rarr;</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .fab-cart-section { padding: 64px 20px; background: #ffffff; min-height: 55vh; }
  .fab-cart-wrap { max-width: 960px; margin: 0 auto; }
  .fab-cart-heading { font-family: Georgia, "Times New Roman", serif; font-size: clamp(28px, 3.6vw, 40px); color: #17212c; margin: 0 0 28px; }
  .fab-cart-items { border-top: 1px solid #e3e8ed; }
  .fab-cart-row { display: flex; align-items: center; gap: 18px; padding: 18px 0; border-bottom: 1px solid #e3e8ed; }
  .fab-cart-thumb { width: 84px; height: 84px; border-radius: 10px; object-fit: cover; border: 1px solid #e3e8ed; }
  .fab-cart-info { flex: 1; }
  .fab-cart-title { font-size: 15px; font-weight: 600; color: #17212c; text-decoration: none; }
  .fab-cart-var, .fab-cart-price { font-size: 13px; color: #64748b; margin: 4px 0 0; }
  .fab-cart-actions { display: flex; align-items: center; gap: 12px; }
  .fab-cart-qty { width: 64px; padding: 8px; border: 1px solid #cbd5e1; border-radius: 8px; text-align: center; }
  .fab-cart-remove { font-size: 12px; color: #64748b; text-decoration: underline; }
  .fab-cart-summary { margin-top: 28px; display: flex; flex-direction: column; align-items: flex-end; gap: 16px; }
  .fab-cart-total { display: flex; gap: 24px; font-size: 18px; color: #17212c; }
  .fab-cart-btns { display: flex; gap: 12px; }
  .fab-cart-update { padding: 12px 20px; border: 1px solid #cbd5e1; background: #ffffff; color: #17212c; border-radius: 10px; font-weight: 600; cursor: pointer; }
  .fab-cart-checkout { padding: 12px 24px; border: 0; background: #145592; color: #ffffff; border-radius: 10px; font-weight: 600; text-decoration: none; cursor: pointer; display: inline-block; }
  .fab-cart-empty { border: 1px solid #e3e8ed; border-radius: 12px; padding: 36px; text-align: center; background: #f8fafc; }
  .fab-cart-empty p { margin: 0 0 16px; color: #64748b; }
</style>

{% schema %}
{
  "name": "fabaddons Cart",
  "settings": []
}
{% endschema %}
