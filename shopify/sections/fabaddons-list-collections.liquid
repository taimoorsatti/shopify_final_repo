{% comment %}
  fabaddons — All Collections Grid
  Upload to: sections/fabaddons-list-collections.liquid
{% endcomment %}

<section class="fab-cols-section">
  <div class="fab-cols-wrap">
    <h1 class="fab-cols-heading">{{ section.settings.heading | escape }}</h1>
    <div class="fab-cols-grid">
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="fab-col-card">
          <div class="fab-col-media">
            {% if collection.featured_image != blank %}
              {{ collection.featured_image | image_url: width: 800 | image_tag: class: 'fab-col-img', loading: 'lazy', alt: collection.title }}
            {% else %}
              <img src="{{ 'product_eye_cream.jpg' | asset_url }}" alt="{{ collection.title | escape }}" class="fab-col-img" loading="lazy">
            {% endif %}
          </div>
          <div class="fab-col-body">
            <h2>{{ collection.title }}</h2>
            <span>Shop Collection &rarr;</span>
          </div>
        </a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="fab-col-card">
          <div class="fab-col-media">
            <img src="{{ 'product_eye_cream.jpg' | asset_url }}" alt="All Products" class="fab-col-img" loading="lazy">
          </div>
          <div class="fab-col-body">
            <h2>All Products</h2>
            <span>Shop Collection &rarr;</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .fab-cols-section { padding: 64px 20px; background: #ffffff; }
  .fab-cols-wrap { max-width: 1240px; margin: 0 auto; }
  .fab-cols-heading { font-family: Georgia, "Times New Roman", serif; font-size: clamp(28px, 3.6vw, 42px); text-align: center; margin: 0 0 36px; color: #17212c; }
  .fab-cols-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .fab-col-card { border: 1px solid #e3e8ed; border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; background: #ffffff; }
  .fab-col-media { aspect-ratio: 4 / 3; background: #f8f9fa; overflow: hidden; }
  .fab-col-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fab-col-body { padding: 18px 20px; }
  .fab-col-body h2 { margin: 0 0 6px; font-size: 16px; color: #17212c; }
  .fab-col-body span { font-size: 13px; font-weight: 600; color: #145592; }
  @media (max-width: 767px) { .fab-cols-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "fabaddons Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Collections" }
  ],
  "presets": [{ "name": "fabaddons Collections" }]
}
{% endschema %}
