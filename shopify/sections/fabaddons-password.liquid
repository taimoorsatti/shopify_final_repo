{% comment %}
  fabaddons — Storefront Password Page
  Upload to: sections/fabaddons-password.liquid
{% endcomment %}

<section class="fab-pw-wrap">
  <div class="fab-pw-card">
    <div class="fab-pw-logo">{{ shop.name | default: 'fabaddons' | escape }}</div>
    <h1 class="fab-pw-title">{{ section.settings.heading | escape }}</h1>
    <p class="fab-pw-copy">{{ shop.password_message | default: section.settings.subtitle | escape }}</p>

    {% form 'storefront_password', class: 'fab-pw-form' %}
      {{ form.errors | default_errors }}
      <input
        type="password"
        name="password"
        id="Password"
        autocomplete="current-password"
        placeholder="Enter store password"
        class="fab-pw-input"
      >
      <button type="submit" class="fab-pw-btn">Enter Store</button>
    {% endform %}
  </div>
</section>

<style>
  .fab-pw-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: #f4f7fa; }
  .fab-pw-card { width: 100%; max-width: 440px; background: #ffffff; border: 1px solid #e3e8ed; border-radius: 16px; padding: 36px 28px; text-align: center; }
  .fab-pw-logo { font-size: 22px; font-weight: 700; color: #145592; margin-bottom: 12px; }
  .fab-pw-title { font-family: Georgia, "Times New Roman", serif; font-size: 28px; margin: 0 0 10px; color: #17212c; }
  .fab-pw-copy { font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 22px; }
  .fab-pw-form { display: flex; flex-direction: column; gap: 12px; }
  .fab-pw-input { width: 100%; padding: 12px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 14px; }
  .fab-pw-btn { width: 100%; padding: 12px 18px; border: 0; border-radius: 10px; background: #145592; color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; }
</style>

{% schema %}
{
  "name": "fabaddons Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Soon" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Enter the storefront password to preview fabaddons." }
  ]
}
{% endschema %}
