{% comment %}
  fabaddons — Bestselling Products Carousel
  Upload to: sections/fabaddons-bestselling-products.liquid
{% endcomment %}

<section id="bestsellers" class="fab-bestsellers" style="background: {{ section.settings.bg_color }};">
  <div class="fab-container">
    <h2 class="fab-serif-heading">{{ section.settings.heading | escape }}</h2>

    <div class="fab-carousel-shell" data-fab-carousel="{{ section.id }}">
      <button type="button" class="fab-circle-arrow" aria-label="Previous products" data-fab-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="fab-track-viewport">
        <div class="fab-product-grid" data-fab-track>
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              <a href="{{ product.url }}" class="fab-product-card" {{ block.shopify_attributes }}>
                <div class="fab-card-media">
                  {% if product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'fab-card-img', alt: product.title }}
                  {% elsif block.settings.fallback_asset != blank %}
                    <img src="{{ block.settings.fallback_asset | asset_url }}" width="900" height="675" alt="{{ product.title | escape }}" class="fab-card-img" loading="lazy">
                  {% endif %}
                </div>
                <div class="fab-card-body">
                  <div class="fab-card-meta">
                    <span>{{ product.type | default: block.settings.fallback_category | default: 'Essentials' }}</span>
                    {% if product.compare_at_price > product.price %}
                      {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                      <span class="fab-discount">Save {{ savings }}%</span>
                    {% endif %}
                  </div>
                  <h3 class="fab-card-title">{{ product.title }}</h3>
                  <div class="fab-price-row">
                    <span class="fab-price">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="fab-compare">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {% else %}
              {% assign fab_key = 'eye-cream' %}
              {% assign title_lc = block.settings.fallback_title | downcase %}
              {% if title_lc contains 'turmeric' %}
                {% assign fab_key = 'turmeric-pads' %}
              {% elsif title_lc contains 'peel' or title_lc contains 'kojic' %}
                {% assign fab_key = 'peel-spray' %}
              {% elsif title_lc contains 'snore' or title_lc contains 'mouth' %}
                {% assign fab_key = 'anti-snore' %}
              {% endif %}
              <a href="{{ routes.root_url }}#fab-product={{ fab_key }}" data-fab-product="{{ fab_key }}" class="fab-product-card" {{ block.shopify_attributes }}>
                <div class="fab-card-media">
                  {% if block.settings.fallback_asset != blank %}
                    <img src="{{ block.settings.fallback_asset | asset_url }}" width="900" height="675" alt="{{ block.settings.fallback_title | escape }}" class="fab-card-img" loading="lazy">
                  {% endif %}
                </div>
                <div class="fab-card-body">
                  <div class="fab-card-meta">
                    <span>{{ block.settings.fallback_category | default: 'Skincare' | escape }}</span>
                    {% if block.settings.fallback_discount != blank %}
                      <span class="fab-discount">{{ block.settings.fallback_discount | escape }}</span>
                    {% endif %}
                  </div>
                  <h3 class="fab-card-title">{{ block.settings.fallback_title | escape }}</h3>
                  <div class="fab-price-row">
                    <span class="fab-price">{{ block.settings.fallback_price | escape }}</span>
                    {% if block.settings.fallback_compare_price != blank %}
                      <span class="fab-compare">{{ block.settings.fallback_compare_price | escape }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button type="button" class="fab-circle-arrow" aria-label="Next products" data-fab-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="fab-cta-wrap">
        {% if section.settings.cta_url != blank %}
          <a href="{{ section.settings.cta_url }}" class="fab-black-btn">{{ section.settings.cta_label | escape }}</a>
        {% else %}
          <a href="{{ routes.root_url }}#fab-product=eye-cream" data-fab-product="eye-cream" class="fab-black-btn">{{ section.settings.cta_label | escape }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .fab-bestsellers { padding: 68px 20px; }
  .fab-container { max-width: 1240px; margin: 0 auto; }
  .fab-serif-heading { text-align: center; font-family: Georgia, "Times New Roman", serif; font-size: clamp(30px, 3.8vw, 44px); font-weight: 600; color: #20232a; margin: 0 0 36px; letter-spacing: -0.025em; }
  .fab-carousel-shell { display: flex; align-items: center; gap: 14px; }
  .fab-track-viewport { overflow: hidden; width: 100%; }
  .fab-product-grid { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3); gap: 24px; transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .fab-product-card { display: flex; flex-direction: column; border: 1px solid #e9e9ec; border-radius: 12px; background: #ffffff; text-decoration: none; overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .fab-product-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.06); }
  .fab-card-media { aspect-ratio: 4 / 3; background: #f8f9fa; overflow: hidden; }
  .fab-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fab-card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 6px; }
  .fab-card-meta { display: flex; justify-content: space-between; font-size: 12px; color: #64748b; }
  .fab-discount { font-weight: 600; color: #145592; }
  .fab-card-title { font-size: 16px; font-weight: 600; color: #17212c; margin: 0; line-height: 1.4; }
  .fab-price-row { display: flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; }
  .fab-price { font-size: 15px; font-weight: 600; color: #17212c; }
  .fab-compare { font-size: 13px; color: #9ca3af; text-decoration: line-through; }
  .fab-circle-arrow { width: 40px; height: 40px; border-radius: 9999px; border: 1px solid #e3e8ed; background: #ffffff; color: #17212c; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .fab-cta-wrap { text-align: center; margin-top: 36px; }
  .fab-black-btn { display: inline-block; background: #111827; color: #ffffff; padding: 13px 28px; border-radius: 8px; font-size: 14px; font-weight: 500; text-decoration: none; }
  @media (max-width: 1023px) { .fab-product-grid { grid-auto-columns: calc((100% - 20px) / 2); gap: 20px; } }
  @media (max-width: 639px) { .fab-product-grid { grid-auto-columns: 100%; gap: 16px; } }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-fab-carousel="{{ section.id }}"]');
    if (!root) return;
    const track = root.querySelector('[data-fab-track]');
    const prev = root.querySelector('[data-fab-prev]');
    const next = root.querySelector('[data-fab-next]');
    let index = 0;
    const visible = () => (window.innerWidth < 640 ? 1 : window.innerWidth < 1024 ? 2 : 3);
    const update = () => {
      const cards = track.children.length;
      const maxIndex = Math.max(0, cards - visible());
      index = Math.max(0, Math.min(index, maxIndex));
      const card = track.children[0];
      if (!card) return;
      const gap = parseFloat(getComputedStyle(track).gap) || 24;
      track.style.transform = `translateX(-${index * (card.getBoundingClientRect().width + gap)}px)`;
    };
    prev?.addEventListener('click', () => { index--; update(); });
    next?.addEventListener('click', () => { index++; update(); });
    window.addEventListener('resize', update);
  })();
</script>

{% schema %}
{
  "name": "fabaddons Bestsellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestselling Products" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All Products" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select product" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image asset", "default": "product_eye_cream.jpg" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Dr. Melaxin Eyephalt Eye Cream" },
        { "type": "text", "id": "fallback_category", "label": "Fallback category", "default": "Skincare" },
        { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "$34.00" },
        { "type": "text", "id": "fallback_compare_price", "label": "Fallback original price", "default": "$44.00" },
        { "type": "text", "id": "fallback_discount", "label": "Fallback discount text", "default": "Save 23%" }
      ]
    }
  ],
  "presets": [{ "name": "fabaddons Bestsellers" }]
}
{% endschema %}