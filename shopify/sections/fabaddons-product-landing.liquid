<script>
  (() => {
    const root = document.getElementById('FabProduct-{{ section.id }}');
    if (!root) return;

    const mainImg = document.getElementById('fpMainImg-{{ section.id }}');
    const thumbs = Array.from(root.querySelectorAll('[data-gal-thumb]'));
    let galIdx = 0;
    const setSlide = (nextIdx) => {
      if (!thumbs.length || !mainImg) return;
      galIdx = (nextIdx + thumbs.length) % thumbs.length;
      const active = thumbs[galIdx];
      if (active.dataset.galSrc) mainImg.src = active.dataset.galSrc;
      thumbs.forEach((btn, i) => btn.classList.toggle('is-active', i === galIdx));
    };
    thumbs.forEach((btn, i) => btn.addEventListener('click', () => setSlide(i)));
    root.querySelector('[data-gal-prev]')?.addEventListener('click', () => setSlide(galIdx - 1));
    root.querySelector('[data-gal-next]')?.addEventListener('click', () => setSlide(galIdx + 1));

    const qtyInput = root.querySelector('[data-qty-input]');
    const livePrice = root.querySelector('[data-live-price]');
    const liveCompare = root.querySelector('[data-live-compare]');
    const liveSave = root.querySelector('[data-live-save]');
    const liveTotal = root.querySelector('[data-live-total]');
    const packBtns = Array.from(root.querySelectorAll('[data-pack-qty]'));
    packBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        packBtns.forEach((b) => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        if (qtyInput) qtyInput.value = btn.dataset.packQty || '1';
        if (livePrice && btn.dataset.packPrice) livePrice.textContent = btn.dataset.packPrice;
        if (liveCompare && btn.dataset.packCompare) liveCompare.textContent = btn.dataset.packCompare;
        if (liveSave && btn.dataset.packSave) liveSave.textContent = btn.dataset.packSave;
        if (liveTotal && btn.dataset.packPrice) liveTotal.textContent = btn.dataset.packPrice;
      });
    });

    const stepTabs = Array.from(root.querySelectorAll('[data-step-caption]'));
    const captionEl = root.querySelector('[data-walk-caption]');
    stepTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        stepTabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        if (captionEl && tab.dataset.stepCaption) captionEl.textContent = tab.dataset.stepCaption;
      });
    });

    const playBtn = root.querySelector('[data-walk-play]');
    const walkVideo = root.querySelector('.fp-walkthrough video');
    const walkReel = root.querySelector('.fp-walkthrough img[data-reel-src]');
    let paused = false;
    playBtn?.addEventListener('click', () => {
      if (walkVideo) {
        if (walkVideo.paused) { walkVideo.play(); playBtn.textContent = 'Pause'; }
        else { walkVideo.pause(); playBtn.textContent = 'Play'; }
        return;
      }
      if (walkReel) {
        paused = !paused;
        const src = paused ? walkReel.dataset.posterSrc : walkReel.dataset.reelSrc;
        if (src) walkReel.src = src;
        playBtn.textContent = paused ? 'Play' : 'Pause';
      }
    });

    const range = root.querySelector('[data-ba-range]');
    const overlay = root.querySelector('[data-ba-overlay]');
    const divider = root.querySelector('[data-ba-divider]');
    range?.addEventListener('input', () => {
      const val = Number(range.value) || 50;
      if (overlay) overlay.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
      if (divider) divider.style.left = `${val}%`;
    });
  })();
</script>

